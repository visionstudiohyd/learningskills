# ======================================================================
#  Copy to .env.local (development) or set in Vercel Project Settings
# ======================================================================

# -------------------- OPTION A: discrete variables --------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=course_enquiry_db
DB_SSL=false
DB_CONNECTION_LIMIT=10
# Fail fast instead of inheriting the ~75s OS TCP timeout when the DB host is
# unreachable; keeps prerender and serverless functions inside their budgets.
DB_CONNECT_TIMEOUT_MS=10000

# -------- OPTION B: one connection string (wins if non-empty) ---------
# Remote MySQL on cPanel: enable "Remote MySQL" and whitelist % or the
# Vercel egress IPs, then use the server hostname/IP (NOT localhost).
# DATABASE_URL="mysql://user:pass@host:3306/dbname?ssl=true"
DATABASE_URL=

# ----------------------------- Auth -----------------------------------
AUTH_SECRET=generate-a-long-random-string
AUTH_COOKIE_NAME=cep_session
AUTH_SESSION_HOURS=12

# ----------------------------- Site -----------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------- Media -----------------------------------
# On Vercel the filesystem is read-only  ->  use MEDIA_DRIVER=db
MEDIA_DRIVER=local
MEDIA_MAX_SIZE_MB=5

# ------------------------- Deploy trigger (CI) ------------------------
# Shared secret for POST /api/deploy, which the GitHub Actions workflow calls
# on every push to main to rebuild the cPanel deployment. Use the SAME value in
# the cPanel Node.js app environment and in the GitHub repo secret
# DEPLOY_SECRET. Never commit the real value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPLOY_SECRET=generate-a-long-random-secret
